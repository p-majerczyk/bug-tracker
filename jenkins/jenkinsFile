pipeline {
    agent none

    stages {
        stage('Unit tests - backend') {
            agent {
                docker {
                    image 'snakee/golang-junit:1.21'
                    reuseNode true
                }
            }
            steps {
                dir('bugtracker-backend') {
                    withEnv(['GOPATH=/tmp/go', 'GOCACHE=/tmp/go/cache']) {
                        sh 'go test -v ./...'
                    }
                }
            }
        }
    }
}